# Copy to .env and fill in. Never commit .env.

# Which model runs everything. groq (default): a free open model, no web search, no
# image/PDF reading; one model for the evaluator, the evals and the judge.
# anthropic: Claude, with research, using the model settings below.
BIE_PROVIDER=groq
GROQ_API_KEY=gsk_...
BIE_GROQ_MODEL=openai/gpt-oss-120b

ANTHROPIC_API_KEY=sk-ant-...

# Model and reasoning effort
BIE_MODEL=claude-opus-5
BIE_JUDGE_MODEL=claude-sonnet-5
BIE_EFFORT=medium
BIE_QUESTION_EFFORT=medium
BIE_VERDICT_EFFORT=high
BIE_PROMPT_VERSION=v3
BIE_MAX_TOKENS=8000
BIE_CONCURRENCY=4

# Submission limits
BIE_MIN_IDEA_CHARS=40
BIE_MAX_ATTACHMENTS=5
BIE_MAX_ATTACHMENT_MB=10

# Research and cost control
# 0 turns live research off: fast and cheap, but the verdict then rests on recalled
# knowledge and says so. Keep it above 0 in production.
BIE_MAX_SEARCHES=8
BIE_MAX_COST_PER_ROUND_USD=1.50
BIE_MAX_COST_PER_SESSION_USD=5.00
# The whole site's budget for one UTC day. In-process and per instance: a brake,
# not a guarantee. Set a monthly budget on the key in the Anthropic Console too.
BIE_MAX_COST_PER_DAY_USD=2.00
BIE_MAX_REASKS=3

# The eval suite runs the whole flow eight times over, so it runs cheap by default.
# `bie eval run --production` ignores these and uses the real settings.
BIE_EVAL_MODEL=claude-sonnet-5
BIE_EVAL_EFFORT=medium
BIE_EVAL_MAX_SEARCHES=3

# Diagnostics. BIE_RECORD=1 writes each reply to tests/fixtures; BIE_REPLAY=<file> replays
# one instead of calling the API at all, which is how a failure gets debugged for free.
# BIE_LEDGER_PATH moves the day's spend ledger (default ~/.bie/spend.json).
# BIE_RECORD=
# BIE_REPLAY=
# BIE_LEDGER_PATH=
