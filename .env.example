# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=sk-ant-...

# Model and reasoning effort
BIE_MODEL=claude-opus-5
BIE_JUDGE_MODEL=claude-sonnet-5
BIE_EFFORT=medium
BIE_QUESTION_EFFORT=medium
BIE_VERDICT_EFFORT=high
BIE_PROMPT_VERSION=v3
BIE_MAX_TOKENS=8000
BIE_CONCURRENCY=4

# Submission limits
BIE_MIN_IDEA_CHARS=40
BIE_MAX_ATTACHMENTS=5
BIE_MAX_ATTACHMENT_MB=10

# Research and cost control
BIE_MAX_SEARCHES=8
BIE_MAX_COST_PER_ROUND_USD=1.50
BIE_MAX_COST_PER_SESSION_USD=5.00
# The whole site's budget for one UTC day. In-process and per instance: a brake,
# not a guarantee. Set a monthly budget on the key in the Anthropic Console too.
BIE_MAX_COST_PER_DAY_USD=5.00
BIE_MAX_REASKS=3

# The eval suite runs the whole flow eight times over, so it runs cheap by default.
# `bie eval run --production` ignores these and uses the real settings.
BIE_EVAL_MODEL=claude-sonnet-5
BIE_EVAL_EFFORT=medium
BIE_EVAL_MAX_SEARCHES=3
