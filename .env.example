# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=sk-ant-...

# Model and reasoning effort
BIE_MODEL=claude-opus-5
BIE_JUDGE_MODEL=claude-sonnet-5
BIE_EFFORT=medium
BIE_QUESTION_EFFORT=medium
BIE_VERDICT_EFFORT=high
BIE_PROMPT_VERSION=v3
BIE_MAX_TOKENS=8000
BIE_CONCURRENCY=4

# Submission limits
BIE_MIN_IDEA_CHARS=40
BIE_MAX_ATTACHMENTS=5
BIE_MAX_ATTACHMENT_MB=10

# Research and cost control
BIE_MAX_SEARCHES=8
BIE_MAX_COST_PER_ROUND_USD=1.50
BIE_MAX_COST_PER_SESSION_USD=5.00
BIE_MAX_REASKS=3
